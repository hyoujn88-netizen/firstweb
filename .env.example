# ==========================================
# .env 예시 파일 (.env.example)
# 이 파일은 GitHub에 올라가는 "견본"이에요. 진짜 값은 절대 넣지 마세요.
# 사용법: 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# ==========================================

# REST API 키 (카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키)
KAKAO_REST_API_KEY=

# JavaScript 키 (웹페이지에서 카카오 SDK를 쓸 때 필요)
KAKAO_JAVASCRIPT_KEY=

# Client Secret (카카오 로그인 > 보안 메뉴에서 발급, 사용 설정한 경우에만 필요)
KAKAO_CLIENT_SECRET=

# Redirect URI (로그인 후 돌아올 주소, 카카오 디벨로퍼스에 등록한 주소와 똑같아야 함)
KAKAO_REDIRECT_URI=

# 로그인 상태를 안전하게 유지하기 위한 임의의 긴 문자열
SESSION_SECRET=
